# Copy this file to MN_Data/.env and fill it in. .env is never uploaded to GitHub.
# Gmail: turn on 2-Step Verification, then create an App password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM=FlowGuard <you@gmail.com>

# Telegram: message @BotFather, send /newbot, paste the token here.
# Then send /start to your bot; it replies with the chat ID to paste into Settings > Notifications.
TELEGRAM_BOT_TOKEN=

# Link used in alerts ("Open incident")
DASHBOARD_URL=http://localhost:5173
